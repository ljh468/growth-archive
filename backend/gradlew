#!/usr/bin/env sh
set -eu

PROJECT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
GRADLE_VERSION="${GRADLE_VERSION:-9.2.1}"
GRADLE_HOME="$PROJECT_DIR/.gradle/bootstrap/gradle-$GRADLE_VERSION"
GRADLE_ZIP="$PROJECT_DIR/.gradle/bootstrap/gradle-$GRADLE_VERSION-bin.zip"
GRADLE_URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$PROJECT_DIR/.gradle/bootstrap"

  if [ ! -f "$GRADLE_ZIP" ]; then
    if ! command -v curl >/dev/null 2>&1; then
      echo "Gradle is not installed and curl is unavailable." >&2
      exit 1
    fi
    curl -fsSL "$GRADLE_URL" -o "$GRADLE_ZIP"
  fi

  if ! command -v unzip >/dev/null 2>&1; then
    echo "Gradle is not installed and unzip is unavailable." >&2
    exit 1
  fi

  unzip -q "$GRADLE_ZIP" -d "$PROJECT_DIR/.gradle/bootstrap"
fi

exec "$GRADLE_HOME/bin/gradle" "$@"
